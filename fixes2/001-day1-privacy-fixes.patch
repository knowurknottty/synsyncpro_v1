+/**
+ * Local-only analytics - Zero external transmission
+ * All data stays in user's browser localStorage
+ * 
+ * Privacy guarantees:
+ * - NO external API calls
+ * - NO IP address collection
+ * - NO device fingerprinting
+ * - NO cross-site tracking
+ * - User can clear all data anytime
+ */
+
+interface AnalyticsEvent {
+  event: string;
+  timestamp: number;
+  data?: Record<string, string | number>;
+}
+
+export class LocalAnalytics {
+  private static readonly STORAGE_KEY = 'synsync_local_analytics';
+  private static readonly MAX_EVENTS = 1000;
+
+  /**
+   * Track event locally - NO external transmission
+   */
+  static track(event: string, data?: Record<string, string | number>): void {
+    try {
+      const events = this.getEvents();
+      events.push({ 
+        event, 
+        timestamp: Date.now(), 
+        data 
+      });
+      
+      // Limit storage size
+      while (events.length > this.MAX_EVENTS) {
+        events.shift();
+      }
+      
+      localStorage.setItem(this.STORAGE_KEY, JSON.stringify(events));
+    } catch (error) {
+      console.error('LocalAnalytics error:', error);
+    }
+  }
+
+  /**
+   * Get all stored events
+   */
+  private static getEvents(): AnalyticsEvent[] {
+    try {
+      const stored = localStorage.getItem(this.STORAGE_KEY);
+      return stored ? JSON.parse(stored) : [];
+    } catch {
+      return [];
+    }
+  }
+
+  /**
+   * Generate anonymous summary (user can share voluntarily)
+   * NO IP, NO device info, NO location
+   */
+  static generateAnonymousSummary(): object {
+    const events = this.getEvents();
+    const protocolCounts: Record<string, number> = {};
+    
+    events
+      .filter(e => e.event === 'protocol_start')
+      .forEach(e => {
+        const id = e.data?.protocolId as string;
+        if (id) {
+          protocolCounts[id] = (protocolCounts[id] || 0) + 1;
+        }
+      });
+
+    return {
+      version: '1.0',
+      totalSessions: events.filter(e => e.event === 'protocol_start').length,
+      protocolPopularity: protocolCounts,
+      timestamp: Date.now(),
+      // Explicitly NO personal data
+    };
+  }
+
+  /**
+   * Clear all analytics data
+   */
+  static clear(): void {
+    localStorage.removeItem(this.STORAGE_KEY);
+  }
+
+  /**
+   * Get dashboard-friendly metrics
+   */
+  static getMetrics() {
+    const events = this.getEvents();
+    const now = Date.now();
+    const dayMs = 24 * 60 * 60 * 1000;
+
+    return {
+      totalSessions: events.filter(e => e.event === 'protocol_start').length,
+      last7Days: events.filter(e => e.event === 'protocol_start' && (now - e.timestamp) < 7 * dayMs).length,
+      last30Days: events.filter(e => e.event === 'protocol_start' && (now - e.timestamp) < 30 * dayMs).length,
+    };
+  }
+}
