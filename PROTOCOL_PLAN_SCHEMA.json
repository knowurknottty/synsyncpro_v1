{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://synsyncpro.app/schemas/protocol-plan-v1.json",
  "title": "SynSync Pro Protocol Plan",
  "description": "JSON schema for practitioner-prescribed protocol plans with scheduling and tracking",
  "type": "object",
  "required": ["schema_version", "type", "meta", "plan", "schedule", "protocols", "tracking", "instructions", "consent", "security"],

  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of this schema (e.g., '1.0.0')"
    },

    "type": {
      "type": "string",
      "const": "synsync-protocol-plan",
      "description": "Fixed identifier for SynSync protocol plans"
    },

    "meta": {
      "type": "object",
      "required": ["id", "created_at", "practitioner", "patient"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Unique identifier for this plan (UUID v4)"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp when plan was created"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "description": "Optional expiration date for this plan"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "Plan version number (increment on updates)"
        },
        "practitioner": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string" },
            "credentials": { "type": "string" },
            "email": { "type": "string", "format": "email" },
            "phone": { "type": "string" },
            "license_number": { "type": "string" },
            "organization": { "type": "string" }
          }
        },
        "patient": {
          "type": "object",
          "required": ["anonymous_id"],
          "properties": {
            "anonymous_id": {
              "type": "string",
              "description": "SHA-256 hash of patient identifier (never store PII)"
            },
            "initials": {
              "type": "string",
              "maxLength": 4
            },
            "age_range": {
              "type": "string",
              "pattern": "^\\d+-\\d+$",
              "examples": ["25-35", "40-50"]
            },
            "assigned_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    },

    "plan": {
      "type": "object",
      "required": ["title", "description", "duration_weeks", "goals"],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200,
          "description": "User-facing plan title"
        },
        "description": {
          "type": "string",
          "maxLength": 1000,
          "description": "Detailed description of plan purpose and approach"
        },
        "category": {
          "type": "string",
          "enum": [
            "anxiety_reduction",
            "sleep_improvement",
            "focus_enhancement",
            "meditation_training",
            "stress_management",
            "cognitive_performance",
            "creativity",
            "pain_management",
            "addiction_recovery",
            "custom"
          ]
        },
        "duration_weeks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 52,
          "description": "Total plan duration in weeks"
        },
        "intensity": {
          "type": "string",
          "enum": ["light", "moderate", "intensive", "clinical"],
          "default": "moderate"
        },
        "evidence_level": {
          "type": "string",
          "enum": ["I", "II", "III", "IV", "V"],
          "description": "Evidence level for this protocol combination"
        },
        "goals": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "maxItems": 10,
          "description": "Measurable goals for this plan"
        },
        "contraindications": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Medical/health conditions that prohibit this plan"
        }
      }
    },

    "schedule": {
      "type": "object",
      "required": ["timezone", "start_date", "phases"],
      "properties": {
        "timezone": {
          "type": "string",
          "description": "IANA timezone (e.g., 'America/Los_Angeles')"
        },
        "start_date": {
          "type": "string",
          "format": "date",
          "description": "Plan start date (ISO 8601 date)"
        },
        "flexible_scheduling": {
          "type": "boolean",
          "default": true,
          "description": "Allow user to adjust session times"
        },
        "grace_period_minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 480,
          "default": 120,
          "description": "Minutes of flexibility around preferred time"
        },
        "phases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/phase"
          }
        },
        "maintenance_phase": {
          "$ref": "#/definitions/maintenancePhase"
        }
      }
    },

    "protocols": {
      "type": "object",
      "required": ["allowed"],
      "properties": {
        "allowed": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Protocol IDs user can access"
        },
        "restricted": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Protocol IDs explicitly blocked"
        },
        "recommended_visualizers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["neural", "cosmic", "oscilloscope", "spectrum", "cymatics", "fractal", "sacred_geometry"]
          }
        },
        "intensity_limits": {
          "type": "object",
          "properties": {
            "volume_max": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "complexity_max": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },

    "tracking": {
      "type": "object",
      "required": ["required_metrics"],
      "properties": {
        "required_metrics": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Metrics that must be tracked"
        },
        "optional_metrics": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/metric"
          }
        },
        "check_ins": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/checkIn"
          }
        },
        "milestones": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/milestone"
          }
        }
      }
    },

    "conditional_logic": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/conditionalRule"
      }
    },

    "instructions": {
      "type": "object",
      "required": ["general"],
      "properties": {
        "general": {
          "type": "object",
          "required": ["setup", "during", "after"],
          "properties": {
            "setup": { "type": "string" },
            "during": { "type": "string" },
            "after": { "type": "string" },
            "safety": { "type": "string" }
          }
        },
        "emergency_contacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["role", "name", "phone"],
            "properties": {
              "role": { "type": "string" },
              "name": { "type": "string" },
              "phone": { "type": "string" },
              "email": { "type": "string", "format": "email" },
              "hours": { "type": "string" },
              "available": { "type": "string" }
            }
          }
        }
      }
    },

    "consent": {
      "type": "object",
      "required": ["required", "text"],
      "properties": {
        "required": {
          "type": "boolean",
          "const": true
        },
        "text": {
          "type": "string",
          "minLength": 100,
          "description": "Full consent text user must acknowledge"
        },
        "patient_signature": {
          "type": "object",
          "properties": {
            "signed": { "type": "boolean" },
            "signed_at": { "type": "string", "format": "date-time" },
            "ip_address": { "type": "string" },
            "user_agent": { "type": "string" }
          }
        }
      }
    },

    "security": {
      "type": "object",
      "required": ["plan_hash", "tamper_detection"],
      "properties": {
        "plan_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "SHA-256 hash of plan for tamper detection"
        },
        "practitioner_signature": {
          "type": "string",
          "description": "Optional PGP signature"
        },
        "tamper_detection": {
          "type": "boolean",
          "const": true
        },
        "encryption": {
          "type": "string",
          "enum": ["none", "aes256", "pgp"]
        },
        "audit_log_enabled": {
          "type": "boolean"
        }
      }
    },

    "export_permissions": {
      "type": "object",
      "properties": {
        "allow_user_export": {
          "type": "boolean",
          "default": true
        },
        "export_formats": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["json", "pdf", "csv"]
          }
        },
        "include_subjective_data": {
          "type": "boolean",
          "default": true
        },
        "anonymize_on_export": {
          "type": "boolean",
          "default": true
        }
      }
    }
  },

  "definitions": {
    "phase": {
      "type": "object",
      "required": ["phase_number", "title", "start_day", "duration_days", "sessions"],
      "properties": {
        "phase_number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "start_day": {
          "type": "integer",
          "minimum": 0
        },
        "duration_days": {
          "type": "integer",
          "minimum": 1
        },
        "mandatory": {
          "type": "boolean",
          "default": true
        },
        "sessions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/session"
          }
        },
        "weekly_targets": {
          "type": "object",
          "properties": {
            "min_sessions": { "type": "integer" },
            "recommended_sessions": { "type": "integer" },
            "rest_days": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
              }
            }
          }
        },
        "progression_criteria": {
          "type": "object",
          "properties": {
            "min_completion_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "required_consecutive_days": {
              "type": "integer"
            },
            "allow_phase_skip": {
              "type": "boolean"
            }
          }
        }
      }
    },

    "session": {
      "type": "object",
      "required": ["id", "protocol_id", "frequency", "time_of_day"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique session identifier within plan"
        },
        "protocol_id": {
          "type": "string",
          "description": "Protocol ID from constants.ts"
        },
        "protocol_version": {
          "type": "string"
        },
        "frequency": {
          "type": "string",
          "enum": ["daily", "2x_per_week", "3x_per_week", "4x_per_week", "5x_per_week", "6x_per_week", "weekly", "biweekly"],
          "description": "How often this session repeats"
        },
        "time_of_day": {
          "type": "string",
          "enum": ["morning", "afternoon", "evening", "night", "anytime"],
          "description": "General time category"
        },
        "preferred_time": {
          "type": "string",
          "pattern": "^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$",
          "description": "Suggested time in HH:MM format"
        },
        "time_window": {
          "type": "string",
          "pattern": "^([0-1]?[0-9]|2[0-3]):[0-5][0-9]-([0-1]?[0-9]|2[0-3]):[0-5][0-9]$",
          "description": "Flexible time range (e.g., '07:00-10:00')"
        },
        "mandatory": {
          "type": "boolean",
          "default": true
        },
        "settings": {
          "type": "object",
          "properties": {
            "volume": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "hdEnabled": {
              "type": "boolean"
            },
            "complexity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "visualizer": {
              "type": "string"
            }
          }
        },
        "instructions": {
          "type": "object",
          "properties": {
            "before": { "type": "string" },
            "during": { "type": "string" },
            "after": { "type": "string" }
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "metric": { "type": "string" },
              "operator": {
                "type": "string",
                "enum": ["<", "<=", ">", ">=", "==", "!="]
              },
              "value": { "type": "number" },
              "action": {
                "type": "string",
                "enum": ["suggest", "require", "skip"]
              }
            }
          }
        }
      }
    },

    "maintenancePhase": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "start_after_completion": {
          "type": "boolean"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/session"
          }
        }
      }
    },

    "metric": {
      "type": "object",
      "required": ["id", "label", "type"],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": ["scale", "boolean", "text", "number"]
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "required": {
          "type": "boolean"
        },
        "frequency": {
          "type": "string",
          "enum": ["per_session", "daily", "weekly"]
        }
      }
    },

    "checkIn": {
      "type": "object",
      "required": ["day", "title", "questions"],
      "properties": {
        "day": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string"
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },

    "milestone": {
      "type": "object",
      "required": ["day", "title"],
      "properties": {
        "day": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "required_sessions": {
          "type": "integer"
        },
        "reward": {
          "type": "string"
        },
        "badge": {
          "type": "string"
        }
      }
    },

    "conditionalRule": {
      "type": "object",
      "required": ["condition", "action"],
      "properties": {
        "condition": {
          "type": "object",
          "required": ["metric", "operator", "value"],
          "properties": {
            "metric": {
              "type": "string"
            },
            "operator": {
              "type": "string",
              "enum": ["<", "<=", ">", ">=", "==", "!="]
            },
            "value": {
              "type": "number"
            },
            "duration_days": {
              "type": "integer",
              "description": "Condition must be true for this many consecutive days"
            }
          }
        },
        "action": {
          "type": "string",
          "enum": ["show_reminder", "show_warning", "suggest_extra_session", "suggest_protocol", "extend_phase", "notify_practitioner"]
        },
        "priority": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "message": {
          "type": "string"
        },
        "protocol_id": {
          "type": "string"
        }
      }
    }
  }
}
